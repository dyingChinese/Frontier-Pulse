{
	"name": "fpulse",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"type": "module",
	"private": "true",
	"scripts": {
		"docs:dev": "cross-env ENVIRONMENT=development vitepress dev docs --mode development ",
		"docs:build": "cross-env ENVIRONMENT=prod_github vitepress build docs --mode prod_github",
		"docs:build:ali": "cross-env ENVIRONMENT=prod_ail vitepress build docs --mode prod_ail",
		"docs:serve": "vitepress serve docs",
		"docs:preview": "vitepress preview docs",
		"prepare": "husky install",
		"lint": "eslint . --fix",
		"prettier": "prettier --write .",
		"commit": "git-cz",
		"commitmsg": "commitlint -E HUSKY_GIT_PARAMS",
		"release": "standard-version",
		"release:alpha": "standard-version --prerelease alpha",
		"release:beta": "standard-version --prerelease beta",
		"release:rc": "standard-version --prerelease rc",
		"lint-staged": "lint-staged"
	},
	"keywords": [],
	"author": "dyingchinese",
	"license": "CC BY",
	"devDependencies": {
		"@commitlint/cli": "^19.5.0",
		"@commitlint/config-conventional": "^19.5.0",
		"@docsearch/css": "^3.6.2",
		"@eslint/eslintrc": "^3.1.0",
		"@eslint/js": "^9.12.0",
		"@types/node": "^22.7.5",
		"@typescript-eslint/eslint-plugin": "^8.9.0",
		"@vueuse/core": "^11.1.0",
		"cz-git": "^1.10.1",
		"eslint": "^9.12.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-import-resolver-typescript": "^3.6.3",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-jsx-a11y": "^6.10.0",
		"eslint-plugin-prettier": "^5.2.1",
		"eslint-plugin-promise": "^7.1.0",
		"eslint-plugin-react": "^7.37.1",
		"eslint-plugin-vue": "^9.29.0",
		"husky": "^9.1.6",
		"lint-staged": "^15.2.10",
		"prettier": "^3.3.3",
		"prettier-eslint": "^16.3.0",
		"sass-embedded": "^1.79.5",
		"scss": "^0.2.4",
		"typescript-eslint": "^8.9.0",
		"vitepress": "^1.4.0",
		"vitepress-auto-sidebar-plugin": "^0.2.4"
	},
	"dependencies": {
		"cross-env": "^7.0.3",
		"vue": "^3.5.12"
	}
}
